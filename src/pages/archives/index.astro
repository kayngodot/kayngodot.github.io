---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type Post, formatDate, getPosts, postUrl, yearOf } from "../../lib/posts";

const posts = await getPosts();
const groups = new Map<string, Post[]>();

for (const post of posts) {
  const year = yearOf(post.data.date);
  const list = groups.get(year) ?? [];
  list.push(post);
  groups.set(year, list);
}
---

<BaseLayout title="归档" description="全部文章，按年份排列。">
  <section class="page-intro shell shell--wide">
    <h1>归档</h1>
    <p class="board-intro__count">共 {posts.length} 篇文章</p>
  </section>

  <section class="archive shell shell--wide">
    {
      [...groups.entries()].map(([year, list]) => (
        <div class="archive-group">
          <h2>{year}</h2>
          <div class="archive-group__items">
            {list.map((post) => (
              <a class="archive-item" href={postUrl(post)}>
                <span>{post.data.title}</span>
                <time datetime={formatDate(post.data.date)}>
                  {formatDate(post.data.date).slice(5)}
                </time>
              </a>
            ))}
          </div>
        </div>
      ))
    }
    {posts.length === 0 && <p class="empty-state">还没有文章。</p>}
  </section>
</BaseLayout>
