---
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { adjacentPosts, getPosts, slugOf } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => {
    const { newer, older } = adjacentPosts(posts, index);
    return {
      params: { slug: slugOf(post) },
      props: { post, newer, older },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={older} next={newer}>
  <Content />
</PostLayout>
