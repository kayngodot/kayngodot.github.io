---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getTagEntries, tagUrl } from "../../lib/posts";

const tags = getTagEntries(await getPosts());
---

<BaseLayout title="标签" description="按标签浏览文章。" active="tags">
  <section class="page-intro shell shell--wide">
    <h1>标签</h1>
    <p class="board-intro__count">{tags.length} 个标签</p>
  </section>

  <section class="tags-page shell shell--wide">
    <div class="tag-cloud">
      {
        tags.map((tag) => (
          <a
            class="tag-chip"
            href={tagUrl(tag.name)}
          >
            {tag.name} <b>{tag.count}</b>
          </a>
        ))
      }
    </div>
    {tags.length === 0 && <p class="empty-state">还没有标签。</p>}
  </section>
</BaseLayout>
