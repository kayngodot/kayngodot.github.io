---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE } from "../../../blog.config.mjs";
import { getPosts, postsInBoard } from "../../lib/posts";

export function getStaticPaths() {
  return SITE.boards.map((board) => ({
    params: { section: board.key },
    props: { board },
  }));
}

const { board } = Astro.props;
const posts = postsInBoard(await getPosts(), board.key);
---

<BaseLayout
  title={board.title}
  description={board.description}
  active={board.key}
>
  <div style={`--accent:${board.accent}`}>
    <section class="board-intro shell shell--wide">
      <div class="board-intro__copy">
        <h1>{board.title}</h1>
        <p>{board.description}</p>
      </div>
      <div class="board-intro__count">{posts.length} 篇文章</div>
    </section>

    <section class="listing shell shell--wide">
      {
        posts.length > 0 ? (
          <div class="post-grid">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="empty-state">这个板块还没有文章。</p>
        )
      }
    </section>
  </div>
</BaseLayout>
